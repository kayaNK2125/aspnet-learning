@model IEnumerable<PracticeWebApp.Models.LINQ_Employe_Model>

@{
	ViewData["Title"] = "CollectionExample";
	Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<h1> Collection Example </h1>

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Id)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Department)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Salary)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Id)
				</td>

				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>

				<td>
					@Html.DisplayFor(modelItem => item.Department)
				</td>

				<td>
					@Html.DisplayFor(modelItem => item.Salary)
				</td>


				@*//this is for the edit, details and delete action links, you can replace the id with the primary key of your model
				<td>
					@Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
					@Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
					@Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
				</td> *@

			</tr>
		}
	</tbody>
</table>