<!DOCTYPE html>
<html>
<head>
    <title>.NET Full Stack Course</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Segoe UI, sans-serif;
            }

            body {
                background: #0f172a;
                color: white;
            }

            .navbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 20px 8%;
                background: #111827;
            }

            .logo {
                font-size: 30px;
                font-weight: bold;
                color: #38bdf8;
            }

            .nav-links a {
                text-decoration: none;
                color: white;
                margin-left: 20px;
            }

            .hero {
                min-height: 80vh;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: center;
                gap: 50px;
                padding: 50px 8%;
            }

            .hero-text {
                flex: 1;
                min-width: 300px;
            }

                .hero-text h1 {
                    font-size: 60px;
                    margin-bottom: 20px;
                }

                .hero-text span {
                    color: #38bdf8;
                }

                .hero-text p {
                    color: #cbd5e1;
                    margin-bottom: 25px;
                    line-height: 1.8;
                }

            .btn {
                background: #38bdf8;
                color: black;
                text-decoration: none;
                padding: 15px 30px;
                border-radius: 8px;
                font-weight: bold;
                display: inline-block;
            }

            .hero-card {
                flex: 1;
                min-width: 300px;
                background: #1e293b;
                padding: 40px;
                border-radius: 20px;
                box-shadow: 0 0 25px rgba(56,189,248,.3);
            }

                .hero-card h2 {
                    margin-bottom: 20px;
                }

                .hero-card ul {
                    list-style: none;
                }

                .hero-card li {
                    padding: 12px 0;
                    border-bottom: 1px solid #334155;
                }

            .section-title {
                text-align: center;
                font-size: 40px;
                margin-bottom: 50px;
            }

            .features {
                padding: 80px 8%;
            }

            .feature-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
                gap: 25px;
            }

            .feature {
                background: #1e293b;
                padding: 30px;
                border-radius: 15px;
            }

                .feature h3 {
                    margin-bottom: 15px;
                    color: #38bdf8;
                }

            .curriculum {
                padding: 80px 8%;
            }

            .course-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
                gap: 25px;
            }

            .course-box {
                background: #1e293b;
                padding: 25px;
                border-radius: 15px;
            }

                .course-box h3 {
                    color: #38bdf8;
                    margin-bottom: 15px;
                }

                .course-box ul {
                    list-style: none;
                }

                .course-box li {
                    margin-bottom: 10px;
                }

            .pricing {
                padding: 80px 8%;
            }

            .price-card {
                max-width: 700px;
                margin: auto;
                background: #1e293b;
                text-align: center;
                padding: 50px;
                border-radius: 20px;
            }

            .price {
                font-size: 70px;
                color: #38bdf8;
                margin: 20px 0;
            }

            .footer {
                text-align: center;
                background: #111827;
                padding: 30px;
                margin-top: 50px;
            }
    </style>
</head>
<body>

    <div class="navbar">
        <div class="logo">CodeMaster</div>

        <div class="nav-links">
            <a href="#">Home</a>
            <a href="#">Course</a>
            <a href="#">Pricing</a>
            <a href="#">Contact</a>
        </div>
    </div>

    <section class="hero">

        <div class="hero-text">
            <h1>Become a <span>.NET Full Stack Developer</span></h1>

            <p>
                Learn C#, ASP.NET Core, MVC, Entity Framework,
                SQL Server, APIs, Authentication, GitHub and
                deployment by building real-world projects.
            </p>

            <a href="#" class="btn">Enroll Now</a>
        </div>

        <div class="hero-card">
            <h2>Course Highlights</h2>

            <ul>
                <li>16 Weeks Training</li>
                <li>10+ Real Projects</li>
                <li>Certificate Included</li>
                <li>Placement Guidance</li>
                <li>Source Code Access</li>
            </ul>
        </div>

    </section>

    <section class="features">

        <h2 class="section-title">Why Choose Us?</h2>

        <div class="feature-grid">

            <div class="feature">
                <h3>Real Projects</h3>
                <p>Build applications used in real companies.</p>
            </div>

            <div class="feature">
                <h3>Industry Skills</h3>
                <p>Learn technologies companies actually use.</p>
            </div>

            <div class="feature">
                <h3>Career Support</h3>
                <p>Resume, interview and portfolio guidance.</p>
            </div>

            <div class="feature">
                <h3>Lifetime Access</h3>
                <p>Access all future updates forever.</p>
            </div>

        </div>

    </section>

    <section class="curriculum">

        <h2 class="section-title">Course Curriculum</h2>

        <div class="course-grid">

            <div class="course-box">
                <h3>C# Programming</h3>
                <ul>
                    <li>OOP</li>
                    <li>Collections</li>
                    <li>LINQ</li>
                    <li>Exception Handling</li>
                </ul>
            </div>

            <div class="course-box">
                <h3>Database</h3>
                <ul>
                    <li>SQL Server</li>
                    <li>Joins</li>
                    <li>Stored Procedures</li>
                    <li>Normalization</li>
                </ul>
            </div>

            <div class="course-box">
                <h3>ASP.NET Core</h3>
                <ul>
                    <li>MVC</li>
                    <li>Authentication</li>
                    <li>Authorization</li>
                    <li>Deployment</li>
                </ul>
            </div>

        </div>

    </section>

    <section class="pricing">

        <div class="price-card">

            <h2>Launch Offer</h2>

            <div class="price">₹4,999</div>

            <p>
                Complete Full Stack Development Training
                with Projects, Certificate and Career Support.
            </p>

            <br>

            <a href="#" class="btn">Join Today</a>

        </div>

    </section>

    <div class="footer">
        © 2026 .NET Full Stack Course
    </div>

</body>
</html>