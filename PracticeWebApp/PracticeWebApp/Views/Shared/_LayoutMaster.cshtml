<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/bootstrap/bootstrap.min.css" rel="stylesheet" />
    @* <link href="~/css/style.css" rel="stylesheet" /> our own css style *@
    <style>
            * {
                margin: 0px;
            }

            html, body {
                height: 100%;
            }

            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }
             
            @@media screeen and (max width: 600px){
                header {
                    background-color: red  !important;
                }
            }
			.nav-link {
                font-size: 25px !important;
                    color: deeppink !important;
            }
            
    </style>
</head>
<body>
    <header class="container-fluid bg-success">
        <div class="row">
            <div class="col-sm-4">
                <a href="https://localhost:7265/">
                    <img class="img-fluid" src="https://static.cdnlogo.com/logos/m/48/microsoft-dot-net.svg" width="60px" alt="Logo" /> </a>
                <b> DOTNET Core Learning </b>
            </div>

            <div class="col-sm-8">
                @* <ul class="nav">
                    <li class="nav-item"><a href="/Guest/Home" class="nav-link">Home</a></li>
                    <li class="nav-item"><a href="/Guest/AboutUs" class="nav-link">About Us</a></li>
                    <li class="nav-item"><a href="/Guest/Services" class="nav-link">Services</a></li>
                    <li class="nav-item"><a href="/Guest/Gallery" class="nav-link">Gallery</a></li>
                    <li class="nav-item"><a href="/Guest/ContactUs" class="nav-link">Contact Us</a></li>
                </ul> *@

                <nav class="navbar navbar-expand-sm bg-success navbar-dark">
                    <div class="container-fluid">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="collapsibleNavbar">
                            <ul class="navbar-nav">
                                <li class="nav-item"><a class="nav-link" href="/Guest/Home">Home</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Guest/AboutUs">About Us</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Guest/Services">Services</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Guest/Gallery">Gallery</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Guest/ContactUs">Contact Us</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>


            </div>
        </div>
    </header>

    <main class="container-fluid bg-secondary flex-grow-1">
        @RenderBody()
        <br />

    </main>

    <footer class="container-fluid bg-success mb-0">
        <br />
        <div class="row">
            <div class="col-sm-4">
                <h3>About Us</h3>
                <p>Lorem Ipsum ...</p>
            </div>

            <div class="col-sm-4">
                <h3>Main Menu</h3>
                <ul>
                    <li><a href="/Guest/Home">Home</a></li>
                    <li><a href="/Guest/AboutUs">About Us</a></li>
                    <li><a href="/Guest/Services">Services</a></li>
                    <li><a href="/Guest/Gallery">Gallery</a></li>
                    <li><a href="/Guest/ContactUs">Contact Us</a></li>
                </ul>
            </div>

            <div class="col-sm-4">
                <h3>Social Icons</h3>

                <a href="https://example.com">
                    <img src="https://cdn.iconscout.com/icon/free/png-256/free-instagram-logo-icon-svg-download-png-3649951.png?f=webp&w=128" height="30px" width="30px" alt="Description">
                </a>
            </div>
        </div>
    </footer>
    <script src="~/bootstrap/bootstrap.bundle.min.js"></script>
</body>