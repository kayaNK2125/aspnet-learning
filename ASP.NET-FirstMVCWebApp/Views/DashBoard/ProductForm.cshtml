@using FirstMvcWebApp.Dto
@model ProductDto

<div> @ViewBag.ErrorMessage </div>
<div class="container mt-5"  >
    <div class="card shadow">
        <div class="card-header">
            <h3>Create Product</h3>
        </div>

        <div class="card-body">
            <form asp-action="CreateProduct">

                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" name="productName" asp-for="ProductName" placeholder="Enter product name" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description" asp-for="Description" placeholder="Enter product description" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input type="number" name="price" asp-for="Price" placeholder="Enter product price" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label">Color</label>
                    <input type="text" name="color" asp-for="Color" placeholder="Enter product color" class="form-control">
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Product
                </button>

                <a href="/Dashboard/Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>