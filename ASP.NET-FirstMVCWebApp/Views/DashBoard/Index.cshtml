@using FirstMvcWebApp.Dto
@model List<ProductDto> 
@* // @model List<ProductDto> tells the view that it will receive a list of ProductDto objects from the controller, allowing it to access their properties safely. *@

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Product Dashboard</h2>

        <a asp-action="ProductForm" class="btn btn-success">
            + Add Product
        </a>
    </div>

    <table class="table table-bordered table-hover table-striped">

        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Color</th>
                <th width="170">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Count > 0)
            {
                foreach (var product in Model)
                {

                    <tr>
                        <td>@product.ProductName</td>
                        <td>@product.Description</td>
                        <td>$@product.Price</td>
                        <td>@product.Color</td>
                        <td>
                            <a asp-action="UpdateProduct" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="DeleteProduct" asp-route-productid="@product.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                     </tr>
                
                }
            }
            else
            {
                <tr> No Product Are Available! </tr>
            }

        </tbody>

    </table>

</div>